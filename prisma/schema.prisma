// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logo      String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  group     String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  shortDescription String?
  description      String?
  price            Int
  offer            Int?
  gender           String?
  colors           String[]
  features         String[]
  images           Json
  inStock          Boolean  @default(true)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  createdAt        DateTime @default(now())
  brand            Brand?   @relation(fields: [brandId], references: [id])
  brandId          String?
}

model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  link      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  size      String   @default("small") // "large" | "small"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  status String @default("pending")

  // Bitpay payment tracking (separate from the fulfillment `status` above).
  // paymentStatus: "unpaid" | "paid" | "failed"
  // paymentAuthority holds Bitpay's id_get; paymentRefId holds Bitpay's trans_id.
  paymentStatus    String    @default("unpaid")
  paymentAuthority String?   @unique
  paymentRefId     Int?
  paidAt           DateTime?

  name       String
  email      String
  phone      String
  address    String
  city       String
  postalCode String
  subtotal   Int
  discount   Int
  shipping   Int
  total      Int
  createdAt  DateTime    @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  name      String
  price     Int
  quantity  Int
  color     String
  image     String?
}

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  image     String?
  createdAt DateTime  @default(now())
  sessions  Session[]
  orders    Order[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}
